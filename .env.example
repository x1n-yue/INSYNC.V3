# Public browser placeholders; optional server placeholders follow below.
# Copy to .env and replace public settings for browser development.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_KEY
VITE_DEMO_MODE=false

# Vercel server-only settings. NEVER give any of these a VITE_ prefix.
APP_ORIGIN=https://YOUR-DEPLOYMENT.vercel.app
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
BACKUP_GITHUB_TOKEN=YOUR_REPOSITORY_SCOPED_ACTIONS_WRITE_TOKEN
BACKUP_GITHUB_REPOSITORY=x1n-yue/INSYNC.V3
BACKUP_GITHUB_REF=main
# Database URL and encryption key belong in GitHub environment secrets only.
# See DEPLOYMENT_READINESS_REPORT.md; do not store actual secrets in this file.
